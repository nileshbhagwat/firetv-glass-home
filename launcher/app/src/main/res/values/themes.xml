<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">@color/text_primary</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/text_pill</item>
        <item name="android:textColor">@color/text_pill</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxWidth">220dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:alpha">0.8</item>
    </style>
</resources>
