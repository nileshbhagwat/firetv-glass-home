<?xml version="1.0" encoding="utf-8"?>
<!-- Glass edge and light sheen drawn over featured artwork; a brighter edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#38FFFFFF"
                        android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="#E6FFFFFF" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#2EFFFFFF"
                        android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                    <corners android:radius="@dimen/tile_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
