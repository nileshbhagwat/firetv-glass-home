<?xml version="1.0" encoding="utf-8"?>
<!-- Glass edge and sheen for one tile of the glass mosaic. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF" android:endColor="#0DFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
