# Copy to tv.env and set your TV's IP address
# (Fire TV: Settings > My Fire TV > About > Network).
TV_IP=192.168.1.50

# Filled in automatically the first time a script reaches the TV: the TV's network card
# (MAC address). If the router gives the TV a new IP address, the scripts find it by this
# and update TV_IP above.
# TV_MAC=aa-bb-cc-dd-ee-ff

# Optional, for featured.bat: your TMDB API Read Access Token (see README, "Home styles").
# TMDB_TOKEN=
